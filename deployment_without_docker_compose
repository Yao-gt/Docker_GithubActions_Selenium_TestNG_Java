# If you want to execute Github Actions without Docker Compose
# Copy the content of this file and replace into the deployment.yaml

name: Deploy

on: push

jobs:
  deploy-test-on-docker:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2

      - name: Creation of grid
        run: docker network create grid

      - name: Docker run selenium-hub
        run: docker run -d -p 4442-4444:4442-4444 --net grid --name selenium-hub selenium/hub

      - name: Docker run node-chrome
        run: docker run -d --net grid -e SE_EVENT_BUS_HOST=selenium-hub --shm-size="2g" -e SE_EVENT_BUS_PUBLISH_PORT=4442 -e SE_EVENT_BUS_SUBSCRIBE_PORT=4443 selenium/node-chrome
      
      - name: Docker run node-firefox
        run: docker run -d --net grid -e SE_EVENT_BUS_HOST=selenium-hub --shm-size="2g" -e SE_EVENT_BUS_PUBLISH_PORT=4442 -e SE_EVENT_BUS_SUBSCRIBE_PORT=4443 selenium/node-firefox
      
      - name: Docker run node-edge
        run: docker run -d --net grid -e SE_EVENT_BUS_HOST=selenium-hub --shm-size="2g" -e SE_EVENT_BUS_PUBLISH_PORT=4442 -e SE_EVENT_BUS_SUBSCRIBE_PORT=4443 selenium/node-edge
      
      - name: Check running containers
        run: docker ps

      - name: Set up JDK 1.8
        uses: actions/setup-java@v1
        with:
          java-version: 1.8

      - name: Build with Maven
        run: mvn test --file pom.xml

      - name: Get Allure history
        uses: actions/checkout@v2
        if: always()
        continue-on-error: true
        with:
          ref: gh-pages
          path: gh-pages

      - name: Allure Report action from marketplace
        uses: simple-elf/allure-report-action@master
        if: always()
        id: allure-report
        with:
          allure_results: allure-results
          gh_pages: gh-pages
          allure_report: allure-report
          allure_history: allure-history
          keep_reports: 20

      - name: Deploy report to Github Pages
        if: always()
        uses: peaceiris/actions-gh-pages@v2
        env:
          PERSONAL_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PUBLISH_BRANCH: gh-pages
          PUBLISH_DIR: allure-history  

      - name: Stopping all containers
        run: docker stop $(docker ps -a -q)
        
      - name: Removes the grid network
        run: docker network rm grid

      - name: Slack Notification
        uses: rtCamp/action-slack-notify@v2
        if: always()
        env:
          SLACK_MESSAGE: 'Allure Report: ${{ secrets.VAULT_ADDR }}'
          SLACK_WEBHOOK: ${{ secrets.SLACK_WEBHOOK }}
 